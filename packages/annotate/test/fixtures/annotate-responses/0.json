{
  "annotations": [
    {
      "elementId": "paragraphs/0",
      "quote": "PRODUCT REQUIREMENTS . INTERNAL TOOLS",
      "type": "product",
      "category": null
    },
    {
      "elementId": "paragraphs/2",
      "quote": "One screen where a consultant tells us what they are good at - and it sticks the moment they click.",
      "type": "functional-requirement",
      "category": null
    },
    {
      "elementId": "paragraphs/4",
      "quote": "We cannot answer \"who knows Jira?\" without asking people.",
      "type": "business-goal",
      "category": null
    },
    {
      "elementId": "paragraphs/5",
      "quote": "Today that data lives in a Power Apps screen.",
      "type": "integration",
      "category": null
    },
    {
      "elementId": "paragraphs/6",
      "quote": "We are rebuilding it as a small Next.js/React app.",
      "type": "imposed-technology",
      "category": null
    },
    {
      "elementId": "paragraphs/8",
      "quote": "A consultant can open the app, find the competency they have in mind, and record their level without thinking about the mechanics - no save step, no second screen.",
      "type": "ux-requirement",
      "category": null
    },
    {
      "elementId": "paragraphs/9",
      "quote": "Nothing is ever lost to a closed tab.",
      "type": "non-functional-requirement",
      "category": "REL"
    },
    {
      "elementId": "paragraphs/11",
      "quote": "The words on the screen match the words the business uses, so nobody has to translate practitioner into advanced in their head.",
      "type": "ux-requirement",
      "category": null
    },
    {
      "elementId": "paragraphs/13",
      "quote": "One audience, and only one: the consultant assessing themselves.",
      "type": "user-class",
      "category": null
    },
    {
      "elementId": "paragraphs/14",
      "quote": "Managers, reviewers and staffing are not users of this release.",
      "type": "out-of-scope",
      "category": null
    },
    {
      "elementId": "paragraphs/17",
      "quote": "Browsing the competency catalogue and narrowing it down",
      "type": "feature",
      "category": null
    },
    {
      "elementId": "paragraphs/18",
      "quote": "Recording, changing and clearing your own level",
      "type": "feature",
      "category": null
    },
    {
      "elementId": "paragraphs/19",
      "quote": "Signing in with corporate SSO",
      "type": "integration",
      "category": null
    },
    {
      "elementId": "paragraphs/21",
      "quote": "Manager, reviewer or validation views",
      "type": "out-of-scope",
      "category": null
    },
    {
      "elementId": "paragraphs/23",
      "quote": "Any way to edit the catalogue itself",
      "type": "out-of-scope",
      "category": null
    },
    {
      "elementId": "paragraphs/25",
      "quote": "Cross-employee search or reporting",
      "type": "out-of-scope",
      "category": null
    },
    {
      "elementId": "paragraphs/76",
      "quote": "The shape of the thing is right and we are keeping it: one flat grid, one row per competency, showing its Type, its Area and its name, with three tick columns for the level.",
      "type": "mockup",
      "category": null
    },
    {
      "elementId": "tables/1/cells/0",
      "quote": "The screen is titled Competencies, not Skills.",
      "type": "ux-requirement",
      "category": null
    },
    {
      "elementId": "tables/1/cells/4",
      "quote": "The Save button and its unsaved-change counter go too.",
      "type": "feature",
      "category": null
    }
  ],
