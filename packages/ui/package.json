    "radix-ui": "^1.6.7",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@dark-factory/eslint-config": "*",
    "@dark-factory/tailwind-config": "*",
    "@dark-factory/typescript-config": "*",
    "@types/node": "26.2.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
