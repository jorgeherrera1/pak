{
  "extends": "@dark-factory/typescript-config/react-library.json",
  "compilerOptions": {
    "module": "Preserve",
    "types": ["node"],
    "moduleResolution": "Bundler",
    "noEmit": true,
    "paths": {
      "@dark-factory/ui/*": ["./src/*"]
    }
  },
  "include": ["src"],
  "exclude": ["node_modules"]
}
