{
  "name": "dark-factory",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "check-types": "turbo run check-types",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "parse": "node --env-file-if-exists=.env packages/parse/src/index.ts",
    "test:integration": "turbo run test:integration",
    "annotate": "node --env-file-if-exists=.env packages/annotate/src/index.ts",
    "preresolve": "turbo run build --filter=@dark-factory/annotate",
    "resolve": "node --env-file-if-exists=.env packages/resolve/src/index.ts",
    "prepipeline": "turbo run build --filter=@dark-factory/annotate",
    "pipeline": "node --env-file-if-exists=.env scripts/pipeline.mts"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "turbo": "^2.10.12",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=24"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "11.19.1"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
